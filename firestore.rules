rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Clients collection
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Settings collection
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Leads collection
    match /leads/{leadId} {
      allow read, write: if true;
    }

    // Orders collection (created via checkout / backend webhook / status sync)
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Transactions collection
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // Dismissed Transactions collection
    match /dismissed_transactions/{dismissedId} {
      allow read, write: if true;
    }

    // Coupons collection (created in finance, read and validated during checkout)
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // All other collections allow authenticated or fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
